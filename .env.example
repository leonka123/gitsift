# ── Core ────────────────────────────────────────────────────────────────────
# Where the SQLite database lives. Created automatically on first run.
DATABASE_PATH=./data/gitsift.db

# Public URL, used for sitemap, RSS, OG images and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── GitHub (optional but recommended) ───────────────────────────────────────
# A classic token with public_repo scope lifts the API limit from 60/h to
# 5,000/h. Needed for serious ingestion, not needed for the demo.
GITHUB_TOKEN=

# ── LLM summaries, rerank and digest intros (optional) ──────────────────────
# Any OpenAI-compatible endpoint works: OpenRouter, OpenAI, Groq, DeepSeek,
# Ollama (http://localhost:11434/v1), LM Studio, etc.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
# Set to false to disable LLM calls entirely (heuristic copy is used instead).
LLM_ENABLED=true

# ── Embeddings (optional) ───────────────────────────────────────────────────
# hash  — zero-config lexical hashing (default, works offline)
# openai — text-embedding-3-small or compatible, better quality
EMBEDDINGS_PROVIDER=hash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Ops ─────────────────────────────────────────────────────────────────────
# Protect /api/cron/ingest with this bearer token.
CRON_SECRET=
